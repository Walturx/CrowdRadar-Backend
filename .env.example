# CrowdRadar backend - copy to .env and adjust. Never commit the real .env.
# Safe placeholders only.

# --- server ---
PUERTO=3000
URL_PUBLICA=http://localhost:3000
CORS_ORIGENES=http://localhost:3000
LOG_NIVEL=info
ZONA_HORARIA=America/Lima
NODE_ENV=development

# --- database (PostgreSQL 16) ---
DB_HOST=localhost
DB_PUERTO=5432
DB_NOMBRE=crowdradar
DB_USUARIO=crowdradar
DB_PASSWORD=cambiar-password-local

# --- security ---
# JWT_SECRETO must have at least 32 characters
JWT_SECRETO=cambiar-este-secreto-por-uno-de-32-caracteres-o-mas
JWT_EXPIRA_EN=2h
BCRYPT_COSTO=10
POLITICA_MENSAJES_AUTH=GENERICA

# --- seeds ---
ADMIN_EMAIL=admin@crowdradar.local
ADMIN_PASSWORD=Cambiar123
