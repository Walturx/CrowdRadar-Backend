# CrowdRadar backend - copy to .env and adjust. Never commit the real .env.
# Every key the API reads is listed here (defaults in parentheses in README.md).
#
# The three values starting with CAMBIAR are placeholders: the API refuses to start
# (and `npm run db:seed` refuses to run) until you replace them with real values.

# --- server ---
NODE_ENV=development
PUERTO=3000
URL_PUBLICA=http://localhost:3000
CORS_ORIGENES=http://localhost:3000
LOG_NIVEL=info
ZONA_HORARIA=America/Lima
# Proxy hops to trust for the client IP (rate-limit key): false, a hop count such as 1, or a name like loopback.
# Leave false unless the API really runs behind that many proxies; true is too permissive.
TRUST_PROXY=false
# Slow-client protection and graceful shutdown limits (milliseconds)
SERVIDOR_REQUEST_TIMEOUT_MS=30000
SERVIDOR_HEADERS_TIMEOUT_MS=15000
SERVIDOR_KEEPALIVE_TIMEOUT_MS=5000
APAGADO_TIMEOUT_MS=10000

# --- database (PostgreSQL 16) ---
DB_HOST=localhost
DB_PUERTO=5432
DB_NOMBRE=crowdradar
DB_USUARIO=crowdradar
# Required, no default. Used by the API and by docker compose for the postgres container.
DB_PASSWORD=CAMBIAR_DB_PASSWORD
# TLS to the database; the server certificate is always verified (private CA: NODE_EXTRA_CA_CERTS)
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000
# Boot: attempts to reach the database (exponential backoff from the wait below) before exiting with 1
DB_REINTENTOS=5
DB_REINTENTO_ESPERA_MS=500

# --- security ---
# Required, at least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRETO=CAMBIAR_GENERE_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
# Duration with a unit: s, m, h or d
JWT_EXPIRA_EN=2h
BCRYPT_COSTO=10
# GENERICA: unknown email and wrong password look identical. DETALLADA: unknown email answers 404.
POLITICA_MENSAJES_AUTH=GENERICA
# Rate limits: attempts per window (minutes)
LIMITE_VENTANA_MIN=15
LIMITE_LOGIN=10
LIMITE_REGISTRO=10
LIMITE_RECUPERAR=5
LIMITE_RESTABLECER=10
LIMITE_PASSWORD=5

# --- business rules ---
RECUPERACION_EXPIRA_MIN=30
COOLDOWN_REPORTE_MIN=30
KARMA_POR_REPORTE=10
KARMA_POR_VALIDACION=2
KARMA_REPORTES_PREMIADOS_DIA=5
SATURACION_ESTRATEGIA=PONDERADA
SATURACION_VENTANA_MIN=60
SATURACION_MIN_REPORTES=3
SATURACION_UMBRAL_MODERADO=1.67
SATURACION_UMBRAL_SATURADO=2.34
CONFIABILIDAD_ESTRATEGIA=PONDERADA_KARMA
CONFIABILIDAD_MIN_VOTOS=3
CONFIABILIDAD_UMBRAL_ALTA=70
CONFIABILIDAD_UMBRAL_MEDIA=40
TOPE_KARMA_PESO=500
RADIO_BUSQUEDA_KM=2
RADIO_PENDIENTES_KM=5
VENTANA_PENDIENTES_HORAS=3
ANALITICA_MIN_MUESTRAS=5
# Must be a subset of 3,7,30: the sancion_usuario.dias CHECK in the frozen migration 06 only allows those
SUSPENSION_DIAS_PERMITIDOS=3,7,30

# --- mail (consola | smtp) ---
CORREO_PROVEEDOR=consola
CORREO_REMITENTE=CrowdRadar <no-responder@crowdradar.local>
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=

# --- push (consola | fcm) ---
PUSH_PROVEEDOR=consola
FCM_CREDENCIALES_RUTA=

# --- seeds ---
ADMIN_EMAIL=admin@crowdradar.local
# At least 10 characters
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN
SEED_DEMO=false
